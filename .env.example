# Copia este archivo a .env en la raiz del repo (API de pronostico)
# API key de OpenAI (sk-proj-...): usada por src/api/main.py para busqueda de eventos y analisis LLM
API_KEY=

# Opcionales: URLs de APIs externas usadas por el pipeline/factores
# FESTIVOS_API_BASE_URL=
# PRONOSTICOS_API_BASE_URL=

# --- fastapi_factores/.env (servicio de factores, usa Postgres local) ---
# DATABASE_URL=postgresql://<usuario>:<clave>@localhost:5432/factores_epm
# APP_ENV=development

# --- Servicio de ajustes por pasos (src/adjustments): Postgres propio de EPM ---
# Va en el .env RAÍZ del repo (el de la API de predicción, src/api/main.py), NO en fastapi_factores/.env.
# Sin esta variable la API arranca igual; /adjustments/run, GET, PATCH y approve responden 503 (preview funciona).
# Aplicar esquema (001 + 002, idempotente): .venv/bin/python scripts/apply_adjustments_schema.py
# AJUSTES_DATABASE_URL=postgresql://<usuario>:<clave>@localhost:5432/<base>
# Auth servicio-a-servicio (backend intermedio -> /adjustments/*). Si se define, todas las rutas /adjustments
# exigen la cabecera `X-Ajustes-Token` con este valor (401 si falta o no coincide). Sin definir: se permite
# todo y la API loguea un warning (solo desarrollo). Usa un secreto largo aleatorio; no lo commitees.
# AJUSTES_SERVICE_TOKEN=<secreto-compartido-con-el-backend-intermedio>

# Cache en disco de los eventos sugeridos por IA (un JSON por UCP/semana, TTL 7 dias).
# Default: .cache/eventos_ajustes (gitignored). Sin API_KEY los eventos se omiten.
# AJUSTES_EVENTOS_CACHE_DIR=
